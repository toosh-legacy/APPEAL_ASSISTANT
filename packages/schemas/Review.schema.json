{
  "$defs": {
    "Issue": {
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "section_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section Id"
        },
        "sentence_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sentence Index"
        },
        "blocking": {
          "default": true,
          "title": "Blocking",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Issue",
      "type": "object"
    },
    "SentenceVerdict": {
      "properties": {
        "section_id": {
          "title": "Section Id",
          "type": "string"
        },
        "sentence_index": {
          "title": "Sentence Index",
          "type": "integer"
        },
        "supported": {
          "title": "Supported",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "score": {
          "default": 0.0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "section_id",
        "sentence_index",
        "supported",
        "reason"
      ],
      "title": "SentenceVerdict",
      "type": "object"
    }
  },
  "properties": {
    "blocking_issues": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "title": "Blocking Issues",
      "type": "array"
    },
    "warnings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "title": "Warnings",
      "type": "array"
    },
    "verdicts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SentenceVerdict"
      },
      "title": "Verdicts",
      "type": "array"
    },
    "score": {
      "default": 0.0,
      "title": "Score",
      "type": "number"
    }
  },
  "title": "Review",
  "type": "object"
}