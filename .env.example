# Local configuration. `make setup` copies this to .env and generates the keys. No real secrets exist locally.
APP_ENV=local

# --- Database (Postgres 16 + pgvector in Docker; host port 55432 because 5432 was taken on the dev machine)
DATABASE_URL=postgresql+psycopg://appeal:appeal_local_only@127.0.0.1:55432/appeal
TEST_DATABASE_URL=postgresql+psycopg://appeal:appeal_local_only@127.0.0.1:55432/appeal_test

# --- Adapters (local | azure). Switching to azure without credentials raises NotConfigured.
QUEUE_BACKEND=postgres
BLOB_BACKEND=azurite
PROGRESS_BACKEND=redis
# offline (default, free, no key) | openai (needs OPENAI_API_KEY) | ollama | azure_openai (Phase C)
LLM_PROVIDER=offline
# Only needed for LLM_PROVIDER=openai. Keep the real key in .env (git-ignored), never in .env.example.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_COST_PER_1K_TOKENS=0
EMBEDDER=minilm
RETRIEVER_BACKEND=postgres
# crossencoder (local ~90 MB model) or none (no download; RRF order)
RERANKER=crossencoder
PII_BACKEND=local
INJECTION_BACKEND=local
OCR_BACKEND=local
MODEL_REGISTRY=local
TELEMETRY_EXPORTER=console

# --- Redis
REDIS_URL=redis://127.0.0.1:56379/0

# --- Azurite (Microsoft's published, well-known emulator key; not a secret)
BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
BLOB_CONTAINER=uploads

# --- Worker: inprocess (background task inside the API) or separate (python -m appeal_worker.main)
WORKER_MODE=separate

# --- Keys generated by `make setup`
MASTER_KEY=generate-me-at-setup
CASE_TOKEN_SECRET=generate-me-at-setup
ADMIN_TOKEN=generate-me-at-setup

# --- Data
IMR_SOURCE=real
FEATURE_INSURER_INSIGHTS=true

# --- Web
WEB_ORIGIN=http://localhost:3100

# --- Azure (Phase C only; leave empty locally)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_SEARCH_ENDPOINT=
AZURE_SERVICEBUS_NAMESPACE=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_LANGUAGE_ENDPOINT=
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_DOCINTEL_ENDPOINT=
AZURE_ML_ENDPOINT=
AZURE_KEYVAULT_URL=
